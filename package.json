    "build:no-lint": "npm run check-lib && vite build --mode prd",
    "lint": "eslint .",
    "preview": "vite preview --port 5174",
    "check-lib": "node scripts/check-lib.cjs",
    "revert-lib": "node scripts/revert-lib.cjs",
    "link-lib": "npm link @cluster-data-experience/qlik-modules || echo already linked"
  },
